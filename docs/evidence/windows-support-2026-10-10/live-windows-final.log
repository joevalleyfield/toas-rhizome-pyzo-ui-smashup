phase = 'selection'
probe_dir = WindowsPath('C:/Users/tim/AppData/Local/Temp/pyzo-execution-917bdd8f')

    def run_owned_probe(
        phase: str,
        probe_dir: Path,
        *,
        expected_returncode: int = 0,
        probe: Path = PROBE,
        phase_variable: str = "PYZO_WORKSPACE_SET_PHASE",
        directory_variable: str = "PYZO_WORKSPACE_SET_PROBE_DIR",
        environment_overrides: dict[str, str] | None = None,
        allow_traceback: bool = False,
        deadline: float = 25.0,
    ):
        if allow_traceback and expected_returncode == 0:
            raise ValueError("traceback allowance requires an expected failure exit")
        current_python = os.environ.get("PYZO_ACCEPTANCE_CURRENT_PYTHON") == "1"
        if not current_python and not UVT.is_file():
            raise AssertionError(f"configured launcher is missing: {UVT}")
        if not current_python and len(QTADS_WHEELS) != 1:
            raise AssertionError(
                f"expected one local QtAds wheel, found: {QTADS_WHEELS}"
            )
        command = [sys.executable, str(probe)] if current_python else [
            str(UVT),
            "run",
            "--python",
            "3.12",
            "--with",
            "PySide6==6.11.1",
            "--with",
            str(QTADS_WHEELS[0]),
            "--with",
            "ipython==9.17.1",
            "python",
            str(probe),
        ]
        environment = os.environ.copy()
        environment.update(
            {
                "PYTHONPATH": os.pathsep.join(
                    (str(ROOT / "deps" / "pyzo"), str(ROOT))
                ),
                "QT_QPA_PLATFORM": "offscreen",
                "PYZO_PEER_FRAMES": "1",
                phase_variable: phase,
                directory_variable: str(probe_dir),
            }
        )
        if environment_overrides:
            environment.update(environment_overrides)
        started = time.monotonic()
        with owned_process(command, cwd=ROOT, env=environment) as process:
            try:
                output, _ = process.communicate(timeout=deadline)
            except subprocess.TimeoutExpired as error:
                _terminate_owned_group(process)
                output, _ = process.communicate(timeout=5)
                raise AssertionError(
                    f"{phase} exceeded external deadline {deadline}s:\n{output}"
                ) from error
        elapsed = time.monotonic() - started
        output = output or ""
        if process.returncode != expected_returncode:
            raise AssertionError(
                f"{phase} exited {process.returncode}, expected {expected_returncode}, "
                f"after {elapsed:.3f}s:\n{output}"
            )
        if ("Traceback" in output and not allow_traceback) or "PROBE TEARDOWN" in output:
