+"""A local backend update cannot retire another loaded workspace's chrome."""
+
+from types import SimpleNamespace as NS
+
+import pyzo
+from pyzo.util._locale import translate
+
+pyzo.translate = translate
+from pyzo.core.main import MainWindow
+
+
+def test_settled_frame_update_retains_other_loaded_workspace_chrome():
+    a, b = object(), object()
+    runtimes = {"a": NS(frame_windows={"a-frame": a}), "b": NS(frame_windows={"b-frame": b})}
+    status, menus = [], []
+    catalog = NS(identities=("a", "b"), runtime=runtimes.__getitem__)
+    host = NS(
+        _peerFrameMode=True,
+        _peerRuntimeCatalog=catalog,
+        _peerStatusProjector=NS(reconcile=status.append),
+        _peerCommandProjector=NS(reconcile=menus.append),
+    )
+    host._peerRuntimeFrameWindows = lambda: MainWindow._peerRuntimeFrameWindows(host)
+    MainWindow._reconcilePeerChrome(host, (b,))
+    assert status == [(a, b)] and menus == [(a, b)]
+    catalog.identities = ("b",)
+    MainWindow._reconcilePeerChrome(host, (b,))
+    assert status[-1] == (b,) and menus[-1] == (b,)
+
+
+def test_each_runtime_chrome_and_focus_are_watched_once():
+    focus, settled, refreshed = [], [], []
+    backend = NS(manager=NS(focusedDockWidgetChanged=NS(connect=focus.append)),
+                 add_settled_callback=settled.append)
+    host = NS(_onFocusedDockWidgetChanged=lambda *_: None,
+              _reconcilePeerChrome=lambda *_: None,
+              _peerCommandProjector=NS(dock_manager=None, refresh=lambda *_: refreshed.append(True)))
+    runtime = NS(backend=backend)
+    MainWindow._watchPeerRuntimeChrome(host, runtime)
+    MainWindow._watchPeerRuntimeChrome(host, runtime)
+    assert focus == [host._onFocusedDockWidgetChanged]
+    assert settled == [host._reconcilePeerChrome]
+
+
+def test_render_focus_does_not_reproject_affiliation_but_user_focus_does(monkeypatch):
+    dock, group = object(), object()
+    metadata, selection = [], []
+    backend = NS(docks={"pane": dock}, _rendering=True, _closing=False,
+                 _pane_id_from_dock=lambda _: "pane")
+    runtime = NS(backend=backend, editor_hosts={group: dock}, shell_hosts={})
+    host = NS(_peerFrameMode=True,
+              _peerRuntimeCatalog=NS(identities=("a",), runtime=lambda _: runtime),
+              _projectPeerFrameMetadata=metadata.append,
+              _peerWorkspaces=NS(adopt_backend_activation=lambda *_: NS(applied=True)))
+    monkeypatch.setattr(pyzo, "editors", NS(setActiveGroup=selection.append), raising=False)
+    MainWindow._onFocusedDockWidgetChanged(host, dock)
+    assert metadata == [] and selection == []
+    backend._rendering = False
+    MainWindow._onFocusedDockWidgetChanged(host, dock)
+    assert metadata == [dock] and selection == [group]
+    metadata.clear()
+    selection.clear()
+    host._peerWorkspaces.adopt_backend_activation = lambda *_: NS(applied=False)
+    MainWindow._onFocusedDockWidgetChanged(host, dock)
+    assert metadata == [] and selection == []
+
+
+def test_context_checkpoint_ignores_quit_teardown_but_resumes_after_cancel(monkeypatch):
+    calls=[]
+    monkeypatch.setattr(pyzo,"workspaceContext",NS(snapshot=lambda _: calls.append("snapshot") or {}),raising=False)
+    host=NS(_peerApplicationExitRequested=True,_peerWorkspaces=NS(workspace_ids=("a",)),
+            _peerContextSnapshot={"a":{}},_refreshWorkspaceAffiliation=lambda:calls.append("affiliation"),
+            _peerStatusProjector=NS(refresh=lambda:calls.append("status")))
+    MainWindow._checkpointPeerContext(host)
+    MainWindow._refreshWorkspaceAffiliation(host) # No runtime remains during quit.
+    assert calls == []
+    host._peerApplicationExitRequested=False
+    MainWindow._checkpointPeerContext(host)
+    assert calls == ["snapshot","affiliation","status"]
diff --git a/tests/test_workspace_retention_context.py b/tests/test_workspace_retention_context.py
new file mode 100644
index 00000000..7facaf1b
--- /dev/null
+++ b/tests/test_workspace_retention_context.py
@@ -0,0 +1,51 @@
+"""Context-only changes must participate in immutable checkpoint generations."""
+
+from copy import deepcopy
+from types import SimpleNamespace as NS
+
+import pyzo
+from pyzo.util._locale import translate
+from spikes.peer_frames.retention import RetentionCoordinator
+
+pyzo.translate = translate
+from pyzo.core.main import MainWindow
+
+
+def test_context_only_checkpoint_captures_both_owners_without_document_edits(monkeypatch):
+    documents = {"documents": {"shared": {"text": "unchanged"}}}
+    profiles = {"a": {"config": {"zoom": 0}, "history": []},
+                "b": {"config": {"zoom": 0}, "history": []}}
+    monkeypatch.setattr(pyzo, "application", NS(documents=NS(
+        persistence_snapshot=lambda: deepcopy(documents))), raising=False)
+    monkeypatch.setattr(pyzo, "workspaceContext", NS(
+        snapshot=lambda owner: deepcopy(profiles[owner])), raising=False)
+    writes = []
+    host = NS(_peerWorkspaces=NS(workspace_ids=("a", "b")))
+    host._savePeerWorkspacePersistence = lambda docs, *, context_snapshot: writes.append(
+        (deepcopy(docs), deepcopy(context_snapshot)))
+    coordinator = RetentionCoordinator(
+        clock=lambda: 0,
+        capture=lambda: MainWindow._capturePeerRetentionSnapshot(host),
+        writer=lambda snapshot, complete: MainWindow._writePeerRetentionSnapshot(
+            host, snapshot, complete),
+        schedule=lambda *_: None,
+    )
+    host._peerRetentionCoordinator = coordinator
+    coordinator.edit()
+    assert coordinator.flush()
+    profiles["a"]["config"]["zoom"] = 2
+    profiles["a"]["history"].append("owned_A")
+    coordinator.edit()
+    # Later mutations must not alter an already captured generation.
+    profiles["b"]["config"]["zoom"] = -1
+    assert coordinator.flush()
+    assert len(writes) == 2
+    assert writes[0][0] == writes[1][0] == documents
+    assert writes[1][1]["a"] == profiles["a"]
+    assert writes[1][1]["b"]["config"]["zoom"] == 0
+    coordinator.edit()
+    assert coordinator.flush()
+    assert writes[2][1] == profiles
+    coordinator.edit()
+    assert coordinator.flush()
+    assert len(writes) == 3
